his.formData);\n          if (res.Success) {\n            this.$message.success(\"Login successful!\");\n            this.$router.push({\n              path: \"/Admin\"\n            });\n          } else {\n            this.$refs.ValidCode.refreshCode();\n          }\n        } else {\n          this.$message.error(\"Login verification failed\");\n          this.$refs.ValidCode.refreshCode();\n          return false;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"sources":["Login.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmEA,OAAA,SAAA,MAAA,8BAAA;AACA,OAAA,KAAA,MAAA,SAAA;AACA,eAAA;EACA,UAAA,EAAA;IACA,SAAA,EAAA;EACA,CAAA;EACA,IAAA,CAAA,EAAA;IACA,OAAA;MACA,QAAA,EAAA;QACA,QAAA,EAAA,EAAA;QACA,QAAA,EAAA,EAAA;QACA,QAAA,EAAA,EAAA;QACA,IAAA,EAAA;MACA,CAAA;MACA,WAAA,EAAA,EAAA;MACA,KAAA,EAAA;QACA,QAAA,EAAA,CACA;UAAA,QAAA,EAAA,IAAA;UAAA,OAAA,EAAA,kCAAA;UAAA,OAAA,EAAA;QAAA,CAAA,CACA;QACA,QAAA,EAAA,CACA;UAAA,QAAA,EAAA,IAAA;UAAA,OAAA,EAAA,4BAAA;UAAA,OAAA,EAAA;QAAA,CAAA,CACA;QACA,QAAA,EAAA,CACA;UAAA,QAAA,EAAA,IAAA;UAAA,OAAA,EAAA,sBAAA;UAAA,OAAA,EAAA;QAAA,CAAA,CACA;QAEA,IAAA,EAAA,CACA;UAAA,QAAA,EAAA,IAAA;UAAA,OAAA,EAAA,oCAAA;UAAA,OAAA,EAAA;QAAA,CAAA,EACA;UACA,SAAA,EAAA,CAAA,IAAA,EAAA,KAAA,EAAA,QAAA,KAAA;YACA,IAAA,YAAA,GAAA,IAAA,CAAA,KAAA,CAAA,SAAA,CAAA,OAAA,CAAA,CAAA;YAEA,IAAA,KAAA,IAAA,YAAA,EAAA;cACA,QAAA,CAAA,IAAA,KAAA,CAAA,4CAAA,CAAA,CAAA;YACA,CAAA,MAAA;cACA,QAAA,CAAA,CAAA;YACA;UACA,CAAA;UAAA,OAAA,EAAA;QACA,CAAA;MAEA;IACA,CAAA;EAEA,CAAA;EACA,OAAA,CAAA,EAAA;IACA,IAAA,CAAA,cAAA,CAAA,CAAA;EACA,CAAA;EACA,OAAA,EAAA;IACA,MAAA,cAAA,CAAA,EAAA;MACA,IAAA;QAAA,IAAA,EAAA;UAAA;QAAA;MAAA,CAAA,GAAA,MAAA,IAAA,CAAA,KAAA,CAAA,kBAAA,CAAA;MAEA,IAAA,CAAA,WAAA,GAAA,KAAA;IAEA,CAAA;IACA,QAAA,CAAA,EAAA;MACA,IAAA,CAAA,KAAA,CAAA,SAAA,CAAA,QAAA,CAAA,MAAA,KAAA,IAAA;QACA,IAAA,KAAA,EAAA;UAEA,IAAA,GAAA,GAAA,MAAA,KAAA,CAAA,QAAA,CAAA,OAAA,EAAA,IAAA,CAAA,QAAA,CAAA;UACA,IAAA,GAAA,CAAA,OAAA,EAAA;YACA,IAAA,CAAA,QAAA,CAAA,OAAA,CAAA,mBAAA,CAAA;YACA,IAAA,CAAA,OAAA,CAAA,IAAA,CAAA;cACA,IAAA,EAAA;YACA,CAAA,CAAA;UAEA,CAAA,MACA;YAEA,IAAA,CAAA,KAAA,CAAA,SAAA,CAAA,WAAA,CAAA,CAAA;UACA;QACA,CAAA,MAAA;UACA,IAAA,CAAA,QAAA,CAAA,KAAA,CAAA,2BAAA,CAAA;UACA,IAAA,CAAA,KAAA,CAAA,SAAA,CAAA,WAAA,CAAA,CAAA;UACA,OAAA,KAAA;QACA;MACA,CAAA,CAAA;IACA;EACA;AACA,CAAA","sourcesContent":["<template>\r\n    <div class=\"login-container\">\r\n        <div class=\"login-box\">\r\n            <!-- 左侧图片区域 -->\r\n            <div class=\"login-left\">\r\n                <div class=\"overlay\"></div>\r\n<!--                <img src=\"@/assets/login1.png\" alt=\"login background\">-->\r\n                <div class=\"welcome-text\">\r\n                    <h1>Welcome Back</h1>\r\n                    <p>Enter your personal details and start your journey with us</p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 右侧登录表单区域 -->\r\n            <div class=\"login-right\">\r\n                <div class=\"login-form-container\">\r\n                    <h2>Login to system</h2>\r\n                    <p class=\"subtitle\">Please enter your account information</p>\r\n\r\n                    <el-form ref=\"loginForm\" :model=\"formData\" :rules=\"rules\">\r\n                        <el-form-item prop=\"UserName\">\r\n                            <el-input v-model.trim=\"formData.UserName\" placeholder=\"Please enter your account number\" prefix-icon=\"el-icon-user\">\r\n                            </el-input>\r\n                        </el-form-item>\r\n\r\n                        <el-form-item prop=\"Password\">\r\n                            <el-input type=\"password\" v-model.trim=\"formData.Password\" placeholder=\"Please enter your password\"\r\n                                prefix-icon=\"el-icon-lock\">\r\n                            </el-input>\r\n\r\n                        </el-form-item>\r\n\r\n                        <el-form-item prop=\"RoleType\" class=\"role-select\">\r\n                            <el-radio-group v-model=\"formData.RoleType\">\r\n                                <el-radio v-for=\"item in roleOptions\" :key=\"item.Code\" :label=\"item.Code\">\r\n                                    {{ item.Label }}\r\n                                </el-radio>\r\n                            </el-radio-group>\r\n                        </el-form-item>\r\n\r\n                        <el-form-item prop=\"Code\" class=\"verify-code\">\r\n                            <div class=\"code-input-group\">\r\n                                <el-input v-model.trim=\"formData.Code\" placeholder=\"Please enter the verification code\">\r\n                                </el-input>\r\n                                <ValidCode ref=\"ValidCode\" class=\"code-image\"></ValidCode>\r\n                            </div>\r\n                        </el-form-item>\r\n\r\n                        <el-form-item>\r\n                            <el-button type=\"primary\" @click=\"LoginBtn\" class=\"login-btn\">\r\n                                login\r\n                            </el-button>\r\n                        </el-form-item>\r\n                    </el-form>\r\n\r\n                    <div class=\"form-footer\">\r\n                        <RouterLink :to=\"{ path: '/ForgetPassword' }\" class=\"forget-pwd\">\r\n                          Register an account?\r\n                        </RouterLink>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport ValidCode from '@/components/Code/canvas.vue';\r\nimport store from '@/store';\r\nexport default {\r\n    components: {\r\n        ValidCode: ValidCode\r\n    },\r\n    data() {\r\n        return {\r\n            formData: {\r\n                UserName: '',\r\n                Password: '',\r\n                RoleType: \"\",\r\n                Code: \"\"\r\n            },\r\n            roleOptions: [],\r\n            rules: {\r\n                UserName: [\r\n                    { required: true, message: 'Please enter your account number', trigger: 'blur' },\r\n                ],\r\n                Password: [\r\n                    { required: true, message: 'Please enter your password', trigger: 'blur' },\r\n                ],\r\n                RoleType: [\r\n                    { required: true, message: 'Please select a role', trigger: 'blur' },\r\n                ],\r\n\r\n                Code: [\r\n                    { required: true, message: 'Please enter the verification code', trigger: 'blur' },\r\n                    {\r\n                        validator: (rule, value, callback) => {\r\n                            let identifyCode = this.$refs.ValidCode.getCode();\r\n\r\n                            if (value != identifyCode) {\r\n                                callback(new Error('Please enter the correct verification code'));\r\n                            } else {\r\n                                callback();\r\n                            }\r\n                        }, trigger: 'blur'\r\n                    }\r\n                ]\r\n            }\r\n        }\r\n\r\n    },\r\n    created() {\r\n        this.GetRoleTypeApi();\r\n    },\r\n    methods: {\r\n        async GetRoleTypeApi() {\r\n            let { Data: { Items } } = await this.$Post(\"/Select/RoleType\");\r\n\r\n            this.roleOptions = Items\r\n\r\n        },\r\n        LoginBtn() {\r\n            this.$refs.loginForm.validate(async (valid) => {\r\n                if (valid) {\r\n\r\n                    let res = await store.dispatch(\"Login\", this.formData);\r\n                    if (res.Success) {\r\n                        this.$message.success(\"Login successful!\");\r\n                        this.$router.push({\r\n                            path: \"/Admin\"\r\n                        })\r\n\r\n                    }\r\n                    else {\r\n\r\n                        this.$refs.ValidCode.refreshCode();\r\n                    }\r\n                } else {\r\n                    this.$message.error(\"Login verification failed\")\r\n                    this.$refs.ValidCode.refreshCode();\r\n                    return false;\r\n                }\r\n            });\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n    height: 100vh;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    background: linear-gradient(135deg, #1a237e 0%, #0d47a1 100%);\r\n}\r\n\r\n.login-box {\r\n    width: 1200px;\r\n    height: 600px;\r\n    display: flex;\r\n    border-radius: 20px;\r\n    overflow: hidden;\r\n    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.login-left {\r\n    position: relative;\r\n    flex: 1;\r\n    background: #000;\r\n    overflow: hidden;\r\n}\r\n\r\n.login-left img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    opacity: 0.7;\r\n}\r\n\r\n.overlay {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    background: linear-gradient(45deg, rgba(26, 35, 126, 0.7) 0%, rgba(13, 71, 161, 0.7) 100%);\r\n    z-index: 1;\r\n}\r\n\r\n.welcome-text {\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    text-align: center;\r\n    color: white;\r\n    z-index: 2;\r\n}\r\n\r\n.welcome-text h1 {\r\n    font-size: 2.5em;\r\n    margin-bottom: 20px;\r\n    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.welcome-text p {\r\n    font-size: 1.1em;\r\n    opacity: 0.9;\r\n}\r\n\r\n.login-right {\r\n    flex: 1;\r\n    background: white;\r\n    padding: 40px;\r\n    display: flex;\r\n    align-items: center;\r\n}\r\n\r\n.login-form-container {\r\n    width: 100%;\r\n    max-width: 400px;\r\n    margin: 0 auto;\r\n}\r\n\r\n.login-form-container h2 {\r\n    font-size: 1.8em;\r\n    color: #333;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.subtitle {\r\n    color: #666;\r\n    margin-bottom: 30px;\r\n}\r\n\r\n.el-input {\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.role-select {\r\n    margin: 20px 0;\r\n}\r\n\r\n.verify-code .code-input-group {\r\n    display: flex;\r\n    gap: 10px;\r\n}\r\n\r\n.code-image {\r\n    flex-shrink: 0;\r\n}\r\n\r\n.login-btn {\r\n    width: 100%;\r\n    height: 45px;\r\n    font-size: 16px;\r\n    margin-top: 20px;\r\n    background: linear-gradient(45deg, #1a237e, #0d47a1);\r\n    border: none;\r\n}\r\n\r\n.login-btn:hover {\r\n    background: linear-gradient(45deg, #0d47a1, #1a237e);\r\n    transform: translateY(-1px);\r\n    transition: all 0.3s ease;\r\n}\r\n\r\n.form-footer {\r\n    margin-top: 20px;\r\n    text-align: right;\r\n}\r\n\r\n.forget-pwd {\r\n    color: #1a237e;\r\n    text-decoration: none;\r\n    font-size: 14px;\r\n}\r\n\r\n.forget-pwd:hover {\r\n    text-decoration: underline;\r\n}\r\n</style>\r\n\r\n\r\n"],"sourceRoot":"src/views"},"metadata":{},"sourceType":"module","externalDependencies":[]}