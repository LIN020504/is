{"ast":null,"code":"//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'App'\n};","map":{"version":3,"sources":["App.vue"],"names":[],"mappings":";;;;;;;AAQA,eAAA;EACA,IAAA,EAAA;AAEA,CAAA","sourcesContent":["<template>\r\n  <div id=\"app\">\r\n    <router-view />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n  name: 'App',\r\n\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\">\r\n@import './css/index.css';\r\n@import \"./css/font/iconfont.css\";\r\n\r\n/**全局样式 */\r\n:root {\r\n  --primary-color: rgba(26, 35, 126, 0.7);\r\n  --content-width: 1300px;\r\n  --active-bg-color: rgba(26, 35, 126, 0.7);\r\n  --active-color: white;\r\n\r\n}\r\n\r\nhtml,\r\nbody {\r\n  background-color: rgb(247, 247, 247);\r\n}\r\n\r\n.pointer {\r\n  cursor: pointer;\r\n}\r\n\r\n.bg-header {\r\n  background-color: var(--primary-color);\r\n  display: flex;\r\n  height: 60px;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 20px;\r\n  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);\r\n  color: white;\r\n}\r\n\r\n\r\n.header-title {\r\n  line-height: 25px;\r\n  color: var(--primary-color);\r\n  border-left: 5px solid var(--primary-color);\r\n  padding-left: 10px;\r\n  font-weight: 700;\r\n  font-size: 18px;\r\n  margin: 5px 0px;\r\n\r\n}\r\n\r\n.rich_content {\r\n  width: 100%;\r\n  margin: 0 auto;\r\n  font-family: 微软雅黑;\r\n  font-size: 16px;\r\n  letter-spacing: 0.2em;\r\n  line-height: 1.5em;\r\n  color: #666161;\r\n  box-sizing: content-box;\r\n  text-align: left;\r\n\r\n  img {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n#nprogress .bar {\r\n  background: var(--primary-color) !important;\r\n}\r\n\r\n\r\n\r\n.card {\r\n  box-shadow: 0 2px 4px rgba(0, 0, 0, .12), 0 0 6px rgba(0, 0, 0, .04);\r\n  border-radius: 10px;\r\n  padding: 20px;\r\n  background: white;\r\n}\r\n\r\n.bg {\r\n  background: url(./assets/login1.png) no-repeat;\r\n  background-size: 100% 100%;\r\n  height: 100vh;\r\n  width: 100vw;\r\n\r\n  .container {\r\n\r\n    height: 100vh;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n  }\r\n}\r\n\r\n.urgency-low {\r\n  background-color: #31930a !important;\r\n  color: white;\r\n  /* Light green */\r\n}\r\n\r\n.urgency-medium {\r\n  background-color: #fcf8e3 !important;\r\n  /* Light yellow */\r\n}\r\n\r\n.urgency-high {\r\n  background-color: #c2cc78 !important;\r\n  /* Light red */\r\n}\r\n\r\n.urgency-critical {\r\n  background-color: #edc9cf !important;\r\n  /* Darker red */\r\n}\r\n</style>\r\n"],"sourceRoot":"src"},"metadata":{},"sourceType":"module","externalDependencies":[]}